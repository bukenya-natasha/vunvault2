let completed=JSON.parse(localStorage.getItem('vv_course_progress')||'[]');
let currentMod=0;

function buildSidebar(){
  const list=document.getElementById('modList');
  list.innerHTML='';
  MODULES.forEach((m,i)=>{
    const done=completed.includes(i);
    const div=document.createElement('div');
    div.className='mod-item'+(i===currentMod?' active':'')+(done?' done':'');
    div.onclick=()=>goModule(i);
    div.innerHTML=`<div class="mod-icon">${done?'✓':(i+1)}</div><div class="mod-text"><div class="mod-name">${m.name}</div><div class="mod-duration">${m.duration}</div></div>`;
    list.appendChild(div);
  });
  const pct=Math.round((completed.length/8)*100);
  document.getElementById('mainProgress').style.width=pct+'%';
  document.getElementById('progLabel').textContent=`${completed.length} of 8 modules complete`;
}

function buildQuizzes(){
  QUIZZES.forEach((quiz,qi)=>{
    const container=document.getElementById('quiz-'+qi);
    if(!container)return;
    quiz.questions.forEach((q,qIdx)=>{
      const div=document.createElement('div');
      div.className='quiz-q';
      div.innerHTML=`<div class="q-text">${qIdx+1}. ${q.q}</div><div class="quiz-options">${q.opts.map((o,oi)=>`<label class="quiz-opt" onclick="selectOpt(this,${qi},${qIdx})"><input type="radio" name="q${qi}_${qIdx}" value="${oi}"> ${o}</label>`).join('')}</div>`;
      container.appendChild(div);
    });
  });
}

function selectOpt(el,qi,qIdx){
  document.querySelectorAll(`[name="q${qi}_${qIdx}"]`).forEach(r=>r.closest('.quiz-opt').classList.remove('selected'));
  el.classList.add('selected');
}

function submitQuiz(qi){
  const quiz=QUIZZES[qi];
  let correct=0;
  quiz.questions.forEach((q,qIdx)=>{
    const selected=document.querySelector(`[name="q${qi}_${qIdx}"]:checked`);
    const opts=document.querySelectorAll(`[name="q${qi}_${qIdx}"]`);
    opts.forEach(r=>{
      const lbl=r.closest('.quiz-opt');
      lbl.classList.remove('correct','wrong','selected');
    });
    if(selected){
      const val=parseInt(selected.value);
      selected.closest('.quiz-opt').classList.add(val===q.correct?'correct':'wrong');
      if(val===q.correct){correct++;
        opts[q.correct].closest('.quiz-opt').classList.add('correct');
      } else {
        opts[q.correct].closest('.quiz-opt').classList.add('correct');
      }
    } else {
      opts[q.correct].closest('.quiz-opt').classList.add('correct');
    }
  });
  const total=quiz.questions.length;
  const pass=correct>=Math.ceil(total*0.6);
  const res=document.getElementById('qresult-'+qi);
  res.style.display='block';
  res.className='quiz-result '+(pass?'pass':'fail');
  res.textContent=pass?`✓ ${correct}/${total} correct — great work! You can proceed.`:`${correct}/${total} correct — review the material above and try again.`;
}

function markDone(i){
  if(!completed.includes(i)){
    completed.push(i);
    localStorage.setItem('vv_course_progress',JSON.stringify(completed));
  }
  const btn=document.getElementById('done-'+i);
  btn.textContent='✓ Completed';
  btn.classList.add('done-state');
  buildSidebar();
}

function goModule(i){
  document.querySelectorAll('.module-section').forEach(s=>s.classList.remove('active'));
  document.getElementById('mod-'+i).classList.add('active');
  document.getElementById('certSection').className='cert-section';
  currentMod=i;
  buildSidebar();
  document.querySelector('.content').scrollIntoView({behavior:'smooth'});
}

function checkCompletion(){
  markDone(7);
  if(completed.length>=6){
    const name=prompt('Enter your name for the certificate:','');
    if(name){
      document.querySelectorAll('.module-section').forEach(s=>s.classList.remove('active'));
      document.getElementById('certSection').className='cert-section show';
      document.getElementById('certName').textContent=name;
      document.getElementById('certDate').textContent=new Date().toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'});
    }
  } else {
    alert('Complete at least 6 modules before claiming your certificate.');
  }
}

// Restore done state on buttons
function restoreDoneStates(){
  completed.forEach(i=>{
    const btn=document.getElementById('done-'+i);
    if(btn){btn.textContent='✓ Completed';btn.classList.add('done-state');}
  });
}

buildSidebar();
buildQuizzes();
restoreDoneStates();
</script>
