<style>
:root{
  --black:#0d0d0d;--dark:#1a1a1a;--mid:#4a4a4a;--light:#787878;
  --rule:#d4d4d4;--rule-soft:#ebebeb;--paper:#ffffff;--paper-warm:#f9f8f6;--hi:#f2f2f0;
  --amber:#ff8a3d;--cyan:#1a73e8;--green:#22c55e;--red:#ef4444;
  --fd:"Big Shoulders Display",sans-serif;
  --fb:"IBM Plex Sans",sans-serif;
  --fm:"IBM Plex Mono",monospace;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--paper);color:var(--dark);font-family:var(--fb);line-height:1.75;}
a{color:var(--black);text-decoration:none;}

header{background:#0a0b0d;border-bottom:1px solid #1f2228;position:sticky;top:0;z-index:200;}
nav{max-width:1200px;margin:0 auto;padding:16px 32px;display:flex;align-items:center;justify-content:space-between;}
.logo{display:flex;align-items:center;gap:10px;font-family:var(--fd);font-size:1.3rem;letter-spacing:0.04em;text-transform:uppercase;color:#e8e6e1;}
.logo svg{width:24px;height:24px;}
.back-link{font-family:var(--fm);font-size:0.78rem;color:#9a9892;letter-spacing:0.04em;text-transform:uppercase;}
.back-link:hover{color:#ff8a3d;}

/* HERO */
.course-hero{background:#0d0d0d;color:#fff;padding:56px 32px 48px;}
.hero-inner{max-width:900px;margin:0 auto;}
.course-badge{display:inline-flex;align-items:center;gap:8px;font-family:var(--fm);font-size:0.68rem;letter-spacing:0.14em;text-transform:uppercase;color:#9a9892;border:1px solid #2a2d33;padding:5px 14px;border-radius:2px;margin-bottom:20px;}
.course-hero h1{font-family:var(--fd);text-transform:uppercase;font-size:clamp(2rem,5vw,3.2rem);line-height:1.05;margin-bottom:16px;}
.course-hero h1 em{font-style:normal;color:#ff8a3d;}
.course-hero p{color:#9a9892;font-size:1rem;max-width:580px;margin-bottom:28px;}
.hero-meta{display:flex;gap:24px;flex-wrap:wrap;font-family:var(--fm);font-size:0.75rem;color:#888;text-transform:uppercase;letter-spacing:0.04em;padding-top:24px;border-top:1px solid #2a2d33;}
.hero-meta span{display:flex;align-items:center;gap:6px;}
.progress-summary{background:#14161a;border:1px solid #2a2d33;border-radius:4px;padding:16px 20px;margin-top:24px;display:flex;align-items:center;gap:16px;}
.prog-track{flex:1;height:6px;background:#2a2d33;border-radius:3px;overflow:hidden;}
.prog-fill{height:100%;background:#ff8a3d;border-radius:3px;transition:width 0.5s ease;width:0%;}
.prog-label{font-family:var(--fm);font-size:0.72rem;color:#9a9892;white-space:nowrap;}

/* LAYOUT */
.course-layout{display:grid;grid-template-columns:280px 1fr;gap:0;max-width:1100px;margin:0 auto;min-height:80vh;}

/* SIDEBAR */
.sidebar{border-right:1px solid var(--rule-soft);padding:32px 24px;position:sticky;top:61px;height:calc(100vh - 61px);overflow-y:auto;}
.sidebar::-webkit-scrollbar{width:3px;}
.sidebar::-webkit-scrollbar-thumb{background:var(--rule);}
.sidebar-title{font-family:var(--fm);font-size:0.68rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--light);margin-bottom:20px;}
.mod-item{display:flex;align-items:flex-start;gap:12px;padding:10px 12px;border-radius:3px;cursor:pointer;margin-bottom:4px;transition:background 0.15s;border:1px solid transparent;}
.mod-item:hover{background:var(--hi);}
.mod-item.active{background:var(--hi);border-color:var(--rule);}
.mod-item.done .mod-icon{background:var(--green);border-color:var(--green);color:#fff;}
.mod-icon{width:24px;height:24px;border:1px solid var(--rule);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--fm);font-size:0.65rem;color:var(--light);flex-shrink:0;margin-top:1px;transition:all 0.2s;}
.mod-text{flex:1;}
.mod-name{font-size:0.85rem;font-weight:600;color:var(--dark);line-height:1.3;}
.mod-duration{font-family:var(--fm);font-size:0.65rem;color:var(--light);margin-top:2px;}
.sidebar-cta{margin-top:24px;padding:16px;background:var(--hi);border-radius:3px;border:1px solid var(--rule-soft);}
.sidebar-cta p{font-size:0.8rem;color:var(--mid);margin-bottom:10px;}
.btn-enroll{display:block;text-align:center;background:var(--black);color:#fff;font-family:var(--fm);font-size:0.72rem;letter-spacing:0.05em;text-transform:uppercase;padding:10px;border-radius:2px;border:none;cursor:pointer;width:100%;}
.btn-enroll:hover{background:#333;}

/* CONTENT */
.content{padding:40px 48px;max-width:720px;}
.module-section{display:none;}
.module-section.active{display:block;}
.section-eyebrow{font-family:var(--fm);font-size:0.68rem;color:var(--amber);text-transform:uppercase;letter-spacing:0.14em;display:flex;align-items:center;gap:8px;margin-bottom:12px;}
.section-eyebrow::before{content:"";width:14px;height:1px;background:var(--amber);}
.content h2{font-family:var(--fd);text-transform:uppercase;font-size:clamp(1.6rem,3vw,2.2rem);color:var(--black);margin-bottom:16px;line-height:1.1;}
.content .lead{font-size:1.05rem;color:var(--mid);margin-bottom:32px;line-height:1.7;}
.content p{color:var(--dark);margin-bottom:20px;font-size:0.97rem;}
.content h3{font-family:var(--fm);font-size:0.88rem;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--black);margin:32px 0 12px;padding-left:12px;border-left:3px solid var(--black);}
.key-box{background:var(--paper-warm);border:2px solid var(--black);padding:20px 24px;margin:24px 0;border-radius:2px;}
.key-box .key-label{font-family:var(--fm);font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--black);margin-bottom:10px;}
.key-box p{margin:0;font-size:0.9rem;}
.warn-box{background:var(--black);color:#fff;padding:20px 24px;margin:24px 0;border-radius:2px;}
.warn-box .warn-label{font-family:var(--fm);font-size:0.65rem;text-transform:uppercase;letter-spacing:0.1em;color:#aaa;margin-bottom:8px;}
.warn-box p{margin:0;color:#e8e6e1;font-size:0.9rem;}
.example-box{background:var(--hi);border-left:3px solid var(--black);padding:16px 20px;margin:20px 0;font-family:var(--fm);font-size:0.82rem;color:var(--mid);line-height:1.6;}
.example-box .ex-label{font-size:0.65rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--light);margin-bottom:6px;}
.stat-row{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:24px 0;}
.stat-cell{border:1px solid var(--rule);padding:16px;text-align:center;}
.stat-num{font-family:var(--fd);font-size:1.8rem;color:var(--black);}
.stat-sub{font-family:var(--fm);font-size:0.65rem;color:var(--light);text-transform:uppercase;letter-spacing:0.04em;margin-top:4px;}
.threat-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:20px 0;}
.threat-card{border:1px solid var(--rule);padding:16px;border-radius:2px;}
.threat-card .t-icon{font-size:1.4rem;margin-bottom:8px;}
.threat-card h4{font-family:var(--fm);font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;}
.threat-card p{font-size:0.82rem;color:var(--mid);margin:0;}
.cia-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:24px 0;}
.cia-card{padding:20px;text-align:center;border:2px solid var(--black);}
.cia-card h4{font-family:var(--fd);font-size:1.1rem;text-transform:uppercase;margin-bottom:8px;}
.cia-card p{font-size:0.82rem;color:var(--mid);}
.strength-meter{margin:20px 0;}
.pw-example{display:flex;justify-content:space-between;align-items:center;padding:10px 14px;border:1px solid var(--rule-soft);margin-bottom:6px;border-radius:2px;font-family:var(--fm);font-size:0.82rem;}
.pw-example .pw-score{padding:3px 10px;border-radius:2px;font-size:0.65rem;font-weight:700;text-transform:uppercase;}
.pw-weak{background:rgba(239,68,68,0.12);color:var(--red);}
.pw-medium{background:rgba(245,158,11,0.12);color:#f59e0b;}
.pw-strong{background:rgba(34,197,94,0.12);color:var(--green);}
.steps-list{display:flex;flex-direction:column;gap:0;border:1px solid var(--rule);overflow:hidden;margin:20px 0;}
.step-row{display:grid;grid-template-columns:48px 1fr;border-bottom:1px solid var(--rule-soft);}
.step-row:last-child{border-bottom:none;}
.step-n{background:var(--black);color:#fff;display:flex;align-items:center;justify-content:center;font-family:var(--fd);font-size:1.2rem;}
.step-c{padding:14px 18px;font-size:0.9rem;}
.step-c strong{display:block;margin-bottom:4px;}
.step-c p{margin:0;color:var(--mid);font-size:0.85rem;}

/* QUIZ */
.quiz-section{margin-top:40px;padding-top:32px;border-top:2px solid var(--black);}
.quiz-section h3{font-family:var(--fd);font-size:1.4rem;text-transform:uppercase;margin-bottom:8px;}
.quiz-section p{color:var(--mid);font-size:0.88rem;margin-bottom:24px;}
.quiz-q{margin-bottom:24px;}
.quiz-q .q-text{font-weight:600;margin-bottom:12px;font-size:0.95rem;}
.quiz-options{display:flex;flex-direction:column;gap:8px;}
.quiz-opt{display:flex;align-items:center;gap:12px;padding:12px 16px;border:1px solid var(--rule);border-radius:2px;cursor:pointer;font-size:0.9rem;transition:all 0.15s;background:transparent;}
.quiz-opt:hover{border-color:var(--black);}
.quiz-opt.selected{border-color:var(--black);background:var(--hi);}
.quiz-opt.correct{border-color:var(--green);background:rgba(34,197,94,0.08);color:#166534;}
.quiz-opt.wrong{border-color:var(--red);background:rgba(239,68,68,0.08);color:#991b1b;}
.quiz-opt input{pointer-events:none;}
.quiz-submit{background:var(--black);color:#fff;border:none;font-family:var(--fm);font-size:0.78rem;letter-spacing:0.05em;text-transform:uppercase;padding:12px 24px;border-radius:2px;cursor:pointer;margin-top:8px;}
