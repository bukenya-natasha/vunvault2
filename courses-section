<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VUNVAULT — Courses</title>
<style>
  :root{
    --bg: #0a0c10;
    --card: #101319;
    --card-hover: #14181f;
    --border: #232833;
    --orange: #f7941d;
    --orange-dim: #b8690f;
    --text: #f2f4f7;
    --muted: #8a94a3;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
    padding:60px 20px 100px;
  }
  .wrap{max-width:1100px;margin:0 auto;}

  /* ---- section header ---- */
  .eyebrow{
    font-family:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace;
    letter-spacing:.12em;
    color:var(--orange);
    font-size:13px;
    margin:0 0 10px;
  }
  h2.section-title{
    font-size:clamp(28px,4vw,40px);
    margin:0 0 40px;
    font-weight:800;
    letter-spacing:-0.01em;
  }

  /* ---- course grid ---- */
  .grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    gap:20px;
    margin-bottom:80px;
  }
  .card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:10px;
    padding:32px 28px;
    display:flex;
    flex-direction:column;
    gap:14px;
    transition:border-color .2s ease, transform .2s ease, background .2s ease;
  }
  .card:hover{
    border-color:var(--orange-dim);
    background:var(--card-hover);
    transform:translateY(-2px);
  }
  .level{
    font-family:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace;
    font-size:12px;
    letter-spacing:.12em;
    color:var(--orange);
  }
  .card h3{
    margin:0;
    font-size:22px;
    font-weight:700;
  }
  .card p{
    margin:0;
    color:var(--muted);
    font-size:15px;
    line-height:1.55;
    flex-grow:1;
  }
  .card .cta{
    margin-top:8px;
    font-size:14px;
    color:var(--orange);
    text-decoration:none;
    font-weight:600;
  }
  .card .cta:hover{text-decoration:underline;}

  /* ---- contact / socials ---- */
  .contact{
    border-top:1px solid var(--border);
    padding-top:56px;
    text-align:center;
  }
  .contact h2{
    font-size:clamp(24px,3.5vw,34px);
    margin:0 0 10px;
    font-weight:800;
  }
  .contact p.sub{
    color:var(--muted);
    font-size:15px;
    margin:0 0 36px;
  }
  .social-row{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:16px;
  }
  .social-btn{
    display:flex;
    align-items:center;
    gap:10px;
    padding:14px 22px;
    border-radius:8px;
    border:1px solid var(--border);
    background:var(--card);
    color:var(--text);
    text-decoration:none;
    font-size:14px;
    font-weight:600;
    transition:border-color .2s ease, background .2s ease, transform .2s ease;
  }
  .social-btn svg{width:18px;height:18px;flex-shrink:0;}
  .social-btn:hover{
    border-color:var(--orange);
    background:var(--card-hover);
    transform:translateY(-2px);
  }
  .social-btn.primary{
    background:var(--orange);
    border-color:var(--orange);
    color:#0a0c10;
  }
  .social-btn.primary:hover{
    background:#ff9f3d;
  }
</style>
</head>
